# ── 环境变量（保留模板文件） ──
.env
.env.local
.env.*.local

# ── Go 构建产物 ──
/bin/
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── 本地中间件数据卷 ──
/data/
/deploy/data/

# ── 测试与覆盖率 ──
*.test
*.out
coverage.txt

# ── 编辑器 / IDE ──
.idea/
.vscode/
*.iml

# ── 调试 ──
__debug_bin

# ── 零散配置（旧模块 vendor 内存在该后缀的文件，保留忽略以免污染仓库） ──
*.conf

# ── 日志 ──
*.log
*.log.*

# ── 文档：忽略散落 md，仅保留根级两份受控文档 ──
*.md
!/README.md
!/REFACTOR_PLAN.md
