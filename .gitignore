# ── 环境变量（保留模板文件） ──
.env
.env.local
.env.*.local

# ── Go 构建产物 ──
/bin/
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── 本地中间件数据卷 ──
/data/
/deploy/data/
# 本地原生 PostgreSQL 实例的数据目录（不入库）
/.localdb/

# ── 测试与覆盖率 ──
*.test
*.out
coverage.txt

# ── 编辑器 / IDE ──
.idea/
.vscode/
*.iml

# ── 调试 ──
__debug_bin

# ── Go 工作区 ──
# 本项目刻意不使用 go.work：跨模块引用统一走仓库依赖（伪版本），
# 以保证各 module 真正独立，可单独构建与发布。IDE 可能自动生成以下文件，直接忽略。
go.work
go.work.sum

# ── 零散配置（旧模块 vendor 内存在该后缀的文件，保留忽略以免污染仓库） ──
*.conf

# ── 日志 ──
*.log
*.log.*

# ── 文档：忽略散落 md，仅保留根级两份受控文档 ──
*.md
!/README.md
!/REFACTOR_PLAN.md
