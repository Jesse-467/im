# ============================================================================
# IM Message · 环境变量模板
#
# 用法：cp .env.example .env 后按环境修改；也可以直接由容器编排注入环境变量
#       （真实环境变量优先级高于 .env 文件，因此生产环境不受本地文件影响）。
#
# 设计原则：所有基础设施均由环境变量驱动，`*_TYPE` 决定具体实现。
#   本地开发 → docker 组件（见 deploy/docker-compose.local.yaml）
#   阿里云   → 只改 TYPE 与地址，业务代码零改动
# ============================================================================

# ── 运行环境 ────────────────────────────────────────────────────────────────
# dev | test | prod
Environment=dev
# account | chat
ServiceName=account

# ── 关系型数据库（PostgreSQL） ──────────────────────────────────────────────
# postgres(本地) | polardb-pg | rds-pg
DB_TYPE=postgres
DB_HOST=127.0.0.1
# 本机原生 PostgreSQL 用 5432；若改用 deploy/docker-compose.local.yaml 提供的
# 容器实例（映射在 15432，以免与本机实例冲突），把这里改为 15432
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=im_local_pass
# 本地免加密；云端数据库通常要求 TLS，届时改为 require 或 verify-full
DB_SSL_MODE=disable
# account 用 im_account，chat 用 im_chat
DB_NAME=im_account
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=1h
# 可选：直接指定完整 DSN（PostgreSQL 关键字/值形式），优先级高于上面的分项配置
DB_DSN=

# ── 缓存 ────────────────────────────────────────────────────────────────────
# redis-standalone(本地) | redis-cluster | redis-sentinel | tair
CACHE_TYPE=redis-standalone
CACHE_ADDRS=127.0.0.1:16379
CACHE_PASSWORD=im_local_pass
CACHE_DB=0
CACHE_POOL_SIZE=100
# 仅 redis-sentinel 模式需要
CACHE_MASTER_NAME=

# ── 消息队列 ────────────────────────────────────────────────────────────────
# kafka(本地) | aliyun-kafka | rocketmq
MQ_TYPE=kafka
MQ_BROKERS=127.0.0.1:19092
# 完整 topic 名为 "<前缀>.<领域>"，例如 im.message，便于多环境共享集群时隔离
MQ_TOPIC_PREFIX=im
MQ_TOPIC_MESSAGE=message
MQ_USERNAME=
MQ_PASSWORD=
MQ_CONSUMER_GROUP=

# ── 注册中心 / 服务发现 ─────────────────────────────────────────────────────
# etcd(本地) | nacos | none
REGISTRY_TYPE=etcd
REGISTRY_ADDRS=127.0.0.1:12379
REGISTRY_NAMESPACE=im

# ── 可观测 ──────────────────────────────────────────────────────────────────
TRACE_ENABLED=true
# OTLP gRPC 端点
TRACE_ENDPOINT=127.0.0.1:4317
TRACE_SAMPLER_RATIO=1.0
METRICS_ENABLED=true
METRICS_PATH=/metrics
LOG_LEVEL=debug
# json | text
LOG_FORMAT=text

# ── 应用自身 ────────────────────────────────────────────────────────────────
# account 默认 8001/9001，chat 默认 8002/9002
HTTP_ADDR=0.0.0.0:8001
GRPC_ADDR=0.0.0.0:9001
JWT_SECRET=dev_only_secret_please_change_in_production
# 令牌有效期，纯数字按秒解释，也支持 24h 这类写法
JWT_ACCESS_EXPIRE=86400

# ── 仅 account 使用：令牌校验模式与多设备在线上限 ───────────────────────────
# self：只验证 JWT 自身（签名 + 过期时间），零存储依赖，但无法提前吊销；
# db  ：在自校验之外还要求数据库中该令牌未被吊销，支持踢下线即时生效。
# 默认 db：多设备在线上限依赖「踢出即失效」。
TOKEN_MODE=db
# 单账号允许同时在线的设备数上限，0 表示不限制。
# 超出时踢出最早登录的设备并吊销其令牌。
MAX_DEVICES_PER_USER=3
# 设备在线标记（Redis 有序集合）的兜底有效期，0 表示不过期。
# 用于回收异常退出、未触发清理的残留标记。
ONLINE_DEVICE_TTL=720h

# ── 仅 chat 使用：所依赖的账号中心 gRPC 地址 ────────────────────────────────
ACCOUNT_RPC_ENDPOINT=127.0.0.1:9001

# ── 仅 chat 使用：是否回查账号中心确认令牌未被吊销 ──────────────────────────
# true（默认）：本地验签通过后，再调用账号中心 VerifyToken。
#   只有账号中心开启 TOKEN_MODE=db 时这条链路才有意义，它让
#   「设备被踢下线」「改密」能立即生效，而不必等令牌自然过期。
# false：仅本地校验（等价 self 模式），零跨服务依赖，但感知不到吊销。
VERIFY_TOKEN_REMOTE=true
